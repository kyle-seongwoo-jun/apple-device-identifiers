{
  "fmt": {
    "semiColons": true,
    "singleQuote": true,
    "include": ["src/"]
  },
  "tasks": {
    "dev:scrape-from-apple": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys=hostname --watch src/scrape-from-apple.ts",
    "dev:scrape-from-xcode": "deno run --allow-run --allow-read --allow-write --watch src/scrape-from-xcode.ts",
    "start:scrape-from-apple": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys=hostname src/scrape-from-apple.ts",
    "start:scrape-from-xcode": "deno run --allow-run --allow-read --allow-write src/scrape-from-xcode.ts",
    "generate-commit-message": "deno run --allow-run=git --allow-read --allow-env --allow-net --allow-sys=hostname src/generate-commit-message.ts"
  },
  "imports": {
    "@ai-sdk/openai": "npm:@ai-sdk/openai@^4.0.46",
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@^0.1.56",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "ai": "npm:ai@^7.0.78",
    "zod": "npm:zod@3"
  }
}
